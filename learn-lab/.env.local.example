# Copy this file to .env.local and put your real keys in it.
# .env.local is ignored by git, so your keys stay on your computer.

# Required.
ANTHROPIC_API_KEY=

# Optional. Empty = local test mode (the lesson runs on your laptop).
# Filled = each student gets a Daytona cloud sandbox.
DAYTONA_API_KEY=

# Optional. Bruno's voice. Empty = the browser's own voice.
ELEVENLABS_API_KEY=

# Later, for speech on Nosana:
# NOSANA_API_KEY=
# WHISPER_URL=
